# Clave de la API de OpenAI (obligatoria)
OPENAI_API_KEY=sk-...
# Modelo de chat a usar
OPENAI_MODEL=gpt-4.1-mini
# (Opcional) temperatura. Déjala vacía o bórrala si tu modelo no admite el
# parámetro "temperature" (p. ej. modelos de razonamiento).
OPENAI_TEMPERATURE=0
# (Opcional) carpeta de datos alternativa; por defecto la carpeta data/ de este proyecto
# EVENTHUB_DATA_DIR=

# --- Langfuse (trazas, prompts y evaluación) -------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Entorno de las trazas (development, staging, production...): separa pruebas de producción
LANGFUSE_TRACING_ENVIRONMENT=development
# Pon 0 para no enviar trazas a Langfuse aunque haya claves
EVENTHUB_LANGFUSE_TRACING=1
# Enmascara los emails (a***@example.com) antes de enviar las trazas a Langfuse
EVENTHUB_LANGFUSE_MASK_PII=1

# --- Prompt de sistema (Langfuse Prompt Management) ------------------------
EVENTHUB_PROMPT_NOMBRE=eventhub-sistema
EVENTHUB_PROMPT_LABEL=production
EVENTHUB_MARCA=EventHub
EVENTHUB_TONO=cercano y profesional
# Usuario por defecto de las trazas (en el chat: /usuario <id>)
EVENTHUB_USUARIO=anonimo

# --- Evaluación --------------------------------------------------------------
EVENTHUB_JUEZ_MODEL=gpt-4.1

# --- LangSmith (solo variables de entorno, sin tocar el código del grafo) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Destino de las trazas: usa SOLO UNA de las dos opciones (ver docs/tutorial-langsmith.md)
# a) Workspace basado en proyectos (cuentas antiguas y autoalojado). En workspaces basados en
#    agentes también funciona: LangSmith crea el agente con ese nombre (comprobado en este proyecto).
LANGSMITH_PROJECT=eventhub-v4
# b) Workspace basado en agentes (organizaciones nuevas de LangSmith Cloud): crea antes
#    el agente "eventhub-v4", comenta LANGSMITH_PROJECT y descomenta estas dos líneas:
# LANGSMITH_AGENT_ID=eventhub-v4
# LANGSMITH_AGENT_ENVIRONMENT=development
