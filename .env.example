# Clave de la API de OpenAI (obligatoria)
OPENAI_API_KEY=sk-...
# Modelo de chat a usar
OPENAI_MODEL=gpt-4.1-mini
# (Opcional) temperatura. Déjala vacía o bórrala si tu modelo no admite el
# parámetro "temperature" (p. ej. modelos de razonamiento).
OPENAI_TEMPERATURE=0
# (Opcional) carpeta de datos alternativa; por defecto la carpeta data/ de este proyecto
# EVENTHUB_DATA_DIR=
